# =============================================================================
# n8n-hubspot-sla-breach-root-cause-latency-profiler :: environment template
# -----------------------------------------------------------------------------
# Copy to .env (git-ignored) or set in your n8n host / container / secret
# manager. Every value is a PLACEHOLDER. Never commit real values, real names,
# portal IDs or webhook URLs (a Slack / Teams webhook URL IS a credential).
#
# SAFE BY DEFAULT: leaving this file untouched keeps the workflow in
# SANDBOX_MODE: zero API calls, nothing posted, zero CRM updates.
# =============================================================================

# ---- n8n runtime --------------------------------------------------------------
# Required so {{ $env.X }} works. If env access is blocked the workflow falls
# back to sandbox defaults instead of failing open.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
GENERIC_TIMEZONE=UTC

# ---- Safety switches (safe defaults shown) ----------------------------------
# Safe-ON: turn off only with an explicit false/0/no/off.
SANDBOX_MODE=true
DRY_RUN=true
# Safe-OFF: turn on only with an explicit true/1/yes/on.
NOTIFICATIONS_ENABLED=false
# Writes sla_status / sla_root_cause / minutes / analysed-at to contacts (the only CRM write).
HUBSPOT_MUTATIONS_ENABLED=false
FORCE_REPOST=false

# ---- Analysis window ------------------------------------------------------------
# Leads whose form-submit timestamp falls in [AS_OF - WINDOW_HOURS, AS_OF).
WINDOW_HOURS=168
# ISO UTC timestamp, e.g. 2026-11-16T10:00:00Z. Empty = now.
AS_OF=

# ---- SLA budgets (minutes) --------------------------------------------------------
TOTAL_SLA_MINUTES=30
HOP_SLA_INGEST_MINUTES=2
HOP_SLA_ENRICH_MINUTES=5
HOP_SLA_ASSIGN_MINUTES=5
HOP_SLA_FIRST_DIAL_MINUTES=15
# wall (24/7) or business (only BUSINESS_HOURS on BUSINESS_DAYS count).
SLA_CLOCK=wall
BUSINESS_HOURS=09:00-18:00
# 0 = Sunday ... 6 = Saturday
BUSINESS_DAYS=1,2,3,4,5
BUSINESS_HOLIDAYS=
# Fixed offset of the SLA time zone from UTC, in minutes (e.g. -300). DST is not applied.
SLA_UTC_OFFSET_MINUTES=0
# A later stage up to this many seconds BEFORE the previous one is treated as clock skew (0 s hop).
CLOCK_SKEW_TOLERANCE_SECONDS=60
# true: a lead past ingest with no enrichment is waiting for an owner (enrichment optional).
ENRICHMENT_OPTIONAL=true
# Optional lifecycle stages to include, e.g. lead,marketingqualifiedlead (empty = all).
LIFECYCLE_STAGES=

# ---- Hop timestamp properties (contacts) -------------------------------------------
# HubSpot built-ins by default; the two custom timestamps come from your ingest
# and enrichment pipelines. Verify internal names in your portal's property export.
FORM_SUBMIT_PROPERTY=first_conversion_date
INGEST_TIMESTAMP_PROPERTY=lead_ingested_at
ENRICHMENT_TIMESTAMP_PROPERTY=lead_enriched_at
OWNER_ASSIGNED_PROPERTY=hubspot_owner_assigneddate
# Default counts any first owner engagement; point it at a dialer-written property for calls only.
FIRST_DIAL_PROPERTY=hs_sa_first_engagement_date
LEAD_SOURCE_PROPERTY=hs_analytics_source

# ---- Contact properties written by the SLA stamp ------------------------------------
STAMP_STATUS_PROPERTY=sla_status
STAMP_ROOT_CAUSE_PROPERTY=sla_root_cause
STAMP_SPEED_TO_LEAD_PROPERTY=sla_speed_to_lead_minutes
STAMP_ANALYZED_AT_PROPERTY=sla_analyzed_at

# ---- Guards ------------------------------------------------------------------------
# Posting is blocked if more than this % of in-window leads have timestamp anomalies.
MAX_ANOMALY_PCT=20
MIN_LEADS_TO_POST=1

# ---- HubSpot ---------------------------------------------------------------------
HUBSPOT_ACCESS_TOKEN=
# Numeric portal ID. 99000001 is the synthetic sandbox placeholder.
HUBSPOT_PORTAL_ID=99000001
HUBSPOT_API_BASE_URL=https://api.hubapi.com
# EU-hosted portals: https://app-eu1.hubspot.com (used for record links only)
HUBSPOT_APP_BASE_URL=https://app.hubspot.com
HUBSPOT_SEARCH_PAGE_SIZE=200

# ---- Notifications ---------------------------------------------------------------
# slack, teams or slack,teams
NOTIFY_CHANNELS=slack
# Slack incoming webhook URL (secret).
SLACK_WEBHOOK_URL=
# Teams Workflows "Post to a channel when a webhook request is received" URL (secret).
TEAMS_WEBHOOK_URL=
NOTIFY_ALLOWED_HOST_SUFFIXES=hooks.slack.com,.logic.azure.com,.powerplatform.com,.powerautomate.com
# name (owner first + last name) or id ("Owner 123").
REP_LABEL=name
MAX_OPEN_BREACHES_LISTED=5
MAX_OWNERS_LISTED=5
REPORT_TITLE=Speed-to-Lead SLA: Breach Root Cause

# ---- Webhook trigger -------------------------------------------------------------
# 16+ random characters. Header x-sla-secret (or ?sla_secret=).
WEBHOOK_SHARED_SECRET=

# ---- Testing ---------------------------------------------------------------------
# Pins "now" (ISO 8601) for reproducible runs.
NOW_OVERRIDE=

